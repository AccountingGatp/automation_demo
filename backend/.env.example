PORT=5000
FRONTEND_URL=http://localhost:3000
XOLA_API_KEY=
XOLA_BASE=https://xola.com/api
DELEGATOR_LIMIT=100
POLL_INTERVAL_MS=3000
POLL_MAX_ATTEMPTS=60

# MongoDB for sync/activity logs
MONGODB_URI=
MONGODB_DB=

# Optional — live QuickBooks Online post
QB_ACCESS_TOKEN=
QB_REALM_ID=
QB_API_BASE=https://quickbooks.api.intuit.com

# Optional — Slack (posts to one channel on each sync)
# Bot: OAuth & Permissions → Bot Token Scopes → chat:write, then install app
SLACK_BOT_TOKEN=
# Channel ID (C…) or name (#your-channel); bot must be in the channel
SLACK_CHANNEL=
# Or use an Incoming Webhook instead of bot token
SLACK_WEBHOOK_URL=
